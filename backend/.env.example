DATABASE_URL=
HF_TOKEN=
# Model and optional :provider suffix are server-side configuration only.
HF_MODEL=Qwen/Qwen3-4B-Instruct-2507:nscale
HF_RESPONSE_FORMAT=schema
GENERATION_EPISODE_CAP=6
GENERATION_JOBS_PER_USER=3
GENERATION_GLOBAL_DAILY_LIMIT=20
GENERATION_MAX_CONCURRENT=2
GENERATION_LEASE_SECONDS=180
# Verified Neon JWT sub permitted to refresh an existing graph; empty disables refresh.
GENERATION_ADMIN_SUBJECT=
UNIVERSE_NODE_CAP=25
UNIVERSE_DEPTH=1
ANILIST_API_URL=https://graphql.anilist.co
FRONTEND_URL=http://localhost:3000
# Full branch Auth URL from Neon Console. Issuer/audience derive from its origin.
# Optional JWKS override: use only the trusted URL supplied by Neon.
NEON_AUTH_JWKS_URL=
NEON_AUTH_BASE_URL=
