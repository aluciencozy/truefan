# Copy backend values to backend/.env and the VITE value to frontend/.env.
# These placeholders are optional for the in-memory demo.
DATABASE_URL=
HF_TOKEN=
ANILIST_API_URL=https://graphql.anilist.co
FRONTEND_URL=http://localhost:3000
VITE_API_URL=http://localhost:8000
# Auth verification: copy exact values for the production branch after enabling Auth.
NEON_AUTH_JWKS_URL=
NEON_AUTH_ISSUER=
# Set if your issued JWTs include an audience; otherwise leave empty.
NEON_AUTH_AUDIENCE=
# Public Neon Auth endpoint (frontend only)
VITE_NEON_AUTH_URL=
