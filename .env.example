# Copy backend values to backend/.env and the VITE value to frontend/.env.
# These placeholders are optional for the in-memory demo.
DATABASE_URL=
HF_TOKEN=
ANILIST_API_URL=https://graphql.anilist.co
FRONTEND_URL=http://localhost:3000
VITE_API_URL=http://localhost:8000
# Full branch Auth URL from Neon Console. Issuer/audience derive from its origin.
# Optional JWKS override: use only the trusted URL supplied by Neon.
NEON_AUTH_JWKS_URL=
NEON_AUTH_BASE_URL=
# Public Neon Auth endpoint (frontend only)
VITE_NEON_AUTH_URL=
# Backend only (never a VITE_ value): blend labelled sample completions into Explore's trending constellations.
# Default is true; set false for real data only. Optional.
# TRENDING_DEMO_SIGNAL=true
